    name: epay_payment_service
  jpa:
    show-sql: true
    # duplicate original line: spring.jpa.show-sql=true
    properties:
      hibernate:
        show_sql: true
        format_sql: true
    hibernate:
      ddl-auto: none
  web:
    resources:
      static-locations: classpath:/,file:/non-existent-folder
  datasource:
    #spring.datasource.url=jdbc:oracle:thin:@10.177.135.4:1590:epaysit2
    #spring.datasource.url=jdbc:oracle:thin:@10.177.135.1:1590:newuat1
