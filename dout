package com.epay.otherinb.validator;

import com.epay.otherinb.dto.DhanalaxmiResponseDto;
import com.epay.otherinb.exceptions.OtherInbPaymentException;
import com.epay.otherinb.util.constants.ErrorConstants;
import org.apache.commons.lang3.StringUtils;
import org.springframework.stereotype.Component;
import java.math.BigDecimal;
import java.util.Map;

@Component
public class OtherInbPaymentValidator {

    public void validateDhanalaxmicallBack(DhanalaxmiResponseDto response) {
        if (response.getAtrn() == null || response.getAtrn().isEmpty()) {
            throw new OtherInbPaymentException(ErrorConstants.INVALID_ERROR_CODE, "ATRN is missing in Web Response");
        }
        if (response.getAmount() == null || response.getAmount().signum() <= 0) {
            throw new OtherInbPaymentException(ErrorConstants.INVALID_ERROR_CODE, "Invalid Amount in Web Response");
        }
    }

    public void validateDhanalaxmiWebResponse(Map<String, String> map) {
        if (!map.containsKey("PRN") || !map.containsKey("BID") || !map.containsKey("PAID") || !map.containsKey("AMT")) {
            throw new OtherInbPaymentException(ErrorConstants.DHANALAXMI_WEB_RESPONSE_ERROR_CODE,
                    "Missing mandatory fields (PRN, BID, PAID, AMT) in decrypted web response");
        }
    }

    public boolean validateWebAndDvAmt(BigDecimal webAmt, BigDecimal dvAmt) {
        if (webAmt == null || dvAmt == null) return false;
        return webAmt.setScale(2, java.math.RoundingMode.HALF_UP)
                .compareTo(dvAmt.setScale(2, java.math.RoundingMode.HALF_UP)) == 0;
    }

    public boolean ValidateBankReferenceNumber(String webSbiRefNo, String dvSbiRefNo) {
        return StringUtils.isNotBlank(webSbiRefNo) &&
                !webSbiRefNo.equals("0") &&
                webSbiRefNo.equals(dvSbiRefNo);
    }
}



