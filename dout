@Service
@RequiredArgsConstructor
public class DhanalaxmiPaymentService {
    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    
    private final OtherInbPaymentValidator otherInbpaymentValidator;
    private final DhanalaxmiPaymentWebClientService dhanalaxmiPaymentWebClientService;
    private final DhanaLaxmiRetailCorpEncryptionDecryptionUtil dhanaLaxmiRetailCorpEncryptionDecryptionUtil;
    private final TransactionDao transactionDao;
    private final OrderDao orderDao;
    private final OtherInbConfigDetails otherInbConfigDetails;
    private final PaymentCallbackForwardService paymentCallbackForwardService;

    private static final String ENC_KEY = "0620c6bca96baa252190504dfd568b8c0a2d146f8ebdb2577bba6f9500f0af84";
    private static final String ENC_IV = "add84f1e3b6a74e8609fcdbc";

    public PaymentFinalResponse processDhanalaxmiCallBack(String webResponse, String channelType) throws Exception {
        logger.info("Processing {} callback for Dhanlaxmi. Raw Response: {}", channelType, webResponse);

        // 1. Clean and Decrypt
        String cleanEncData = webResponse.replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY).replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY);
        String decryptedWebResponse = DhanaLaxmiRetailCorpEncryptionDecryptionUtil.decryptDhanalaxmiRetail(cleanEncData, ENC_KEY, ENC_IV);
        logger.info("Decrypted Web Response for {}: {}", channelType, decryptedWebResponse);

        // 2. Map and Validate
        Map<String, String> decryptedMap = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.getDecryptedData(decryptedWebResponse);
        otherInbpaymentValidator.validateDhanalaxmiWebResponse(decryptedMap);

        DhanalaxmiResponseDto responseDto = DhanalaxmiResponseDto.builder()
                .atrn(decryptedMap.get("PRN"))
                .bId(decryptedMap.get("BID"))
                .paId(decryptedMap.get("PAID"))
                .amount(new BigDecimal(decryptedMap.get("AMT")))
                .build();

        otherInbpaymentValidator.validateDhanalaxmicallBack(responseDto);

        // 3. Check Bank Status
        if (!"Y".equalsIgnoreCase(responseDto.getPaId())) {
            logger.warn("Transaction FAILED at bank end for ATRN: {}", responseDto.getAtrn());
            return getRedirectObject(responseDto);
        }

        // 4. Trigger Double Verification
        logger.info("Web Response status is Y. Initiating Double Verification for ATRN: {}", responseDto.getAtrn());
        return dhanalaxmiDvinitiationProcess(responseDto, channelType);
    }

    public PaymentFinalResponse dhanalaxmiDvinitiationProcess(DhanalaxmiResponseDto responseDto, String channelType) throws Exception {
        logger.info("Fetching DB details for DV process for ATRN: {}", responseDto.getAtrn());
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(responseDto.getAtrn(), PaymentStatus.BOOKED.toString(), OtherInbConstants.DHANALAXMI_CONST);

        // Build and Encrypt DV Request
        String dvRequestString = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.processDhanalaxmiDoubleVerRequest1(responseDto);
        logger.info("Plain DV Request String to Bank: {}", dvRequestString);
        
        String encryptedDvData = DhanaLaxmiRetailCorpEncryptionDecryptionUtil.encryptDhanalaxmiRetail(dvRequestString, ENC_KEY, ENC_IV);
        
        // Call WebClient
        logger.info("Calling DV API for ATRN: {}", responseDto.getAtrn());
        DhanalaxmiDvResponse dvResponseJson = dhanalaxmiPaymentWebClientService.processingDoubleVerRequest(encryptedDvData);

        if (dvResponseJson == null || !"000".equals(dvResponseJson.getStatusCode())) {
            logger.error("DV API Failed or returned null for ATRN: {}. Status: {}", responseDto.getAtrn(), dvResponseJson != null ? dvResponseJson.getStatusDescription() : "NULL");
            return getRedirectObject(responseDto);
        }

        // Decrypt DV Response
        String decryptedDvString = URLDecoder.decode(DhanaLaxmiRetailCorpEncryptionDecryptionUtil.decryptDhanalaxmiRetail(dvResponseJson.getVerificationResponse(), ENC_KEY, ENC_IV), StandardCharsets.UTF_8);
        logger.info("Decrypted DV Response for ATRN {}: {}", responseDto.getAtrn(), decryptedDvString);

        Map<String, String> dvMap = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.getDecryptedData(decryptedDvString);

        // Verify Checksum (Using Fixed SHA-256)
        String expectedChecksumString = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.buildDvResponseChecksumString(
                dvMap.get("PRN"), dvMap.get("BID"), dvMap.get("PAID"), dvMap.get("AMT"), 
                dvMap.get("ACCOUNTNO"), dvMap.get("PAYDATE"), dvMap.get("REMNAME"), dvMap.get("PAYREFNO"));
        String calculatedChecksum = DhanaLaxmiRetailCorpEncryptionDecryptionUtil.checkSumDhanalaxmiRetail(expectedChecksumString);

        if (!calculatedChecksum.equalsIgnoreCase(dvMap.get("CHECKSUM"))) {
            logger.error("DV Checksum Mismatch! Expected: {}, Calculated: {}", dvMap.get("CHECKSUM"), calculatedChecksum);
            throw new OtherInbPaymentException(ErrorConstants.DHANALAXMI_DV_CHECKSUM_MISMATCH_ERROR_CODE, ErrorConstants.DHANALAXMI_DV_CHECKSUM_MISMATCH_ERROR_MESSAGE);
        }

        // Amount Validation
        if (!otherInbpaymentValidator.validateWebAndDvAmt(responseDto.getAmount(), new BigDecimal(dvMap.get("AMT")))) {
            logger.error("DV Amount Mismatch for ATRN: {}. Web Amt: {}, DV Amt: {}", responseDto.getAtrn(), responseDto.getAmount(), dvMap.get("AMT"));
            return getRedirectObject(responseDto);
        }

        // Bank Ref Validation
        if (!otherInbpaymentValidator.ValidateBankReferenceNumber(responseDto.getBId(), dvMap.get("BID"))) {
            logger.error("DV Bank Ref Number Mismatch for ATRN: {}. Web BID: {}, DV BID: {}", responseDto.getAtrn(), responseDto.getBId(), dvMap.get("BID"));
            return getRedirectObject(responseDto);
        }

        // Corporate Specific Validation: Account Number
        if ("CORPORATE".equalsIgnoreCase(channelType) && transactionDto.getCorporateAccountNo() != null) {
            if (!transactionDto.getCorporateAccountNo().equals(dvMap.get("ACCOUNTNO"))) {
                logger.error("DV ACCOUNTNO Mismatch for Corporate ATRN: {}. Expected: {}, Got: {}", responseDto.getAtrn(), transactionDto.getCorporateAccountNo(), dvMap.get("ACCOUNTNO"));
                throw new OtherInbPaymentException(ErrorConstants.INVALID_ERROR_CODE, "Debited account does not match corporate account");
            }
            logger.info("Corporate Account Number matched successfully for ATRN: {}", responseDto.getAtrn());
        }

        logger.info("Dhanlaxmi DV Validation Successful for ATRN: {} (Channel: {})", responseDto.getAtrn(), channelType);
        return getRedirectObject(responseDto);
    }

    public PaymentFinalResponse getRedirectObject(DhanalaxmiResponseDto responseDto) {
        logger.info("Building final redirect object for ATRN: {}", responseDto.getAtrn());
        TransactionDto transactionDto = transactionDao.getTransactionDetails(responseDto.getAtrn());
        Order order = orderDao.getOrderDetails(transactionDto);

        String status = responseDto.getPaId().equalsIgnoreCase("Y") ? OtherInbConstants.SUCCESS : OtherInbConstants.FAILED;
        FinalResponseStatus finalResponseStatus = getStatus(transactionDto, order, status, responseDto.getPaId());

        return PaymentFinalResponse.builder()
                .mId(transactionDto.getMerchantId() == null ? OtherInbConstants.EMPTY : transactionDto.getMerchantId())
                .merchantOrderNumber(transactionDto.getOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getOrderRefNumber())
                .sbiOrderId(transactionDto.getSbiOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getSbiOrderRefNumber())
                .orderAmount(String.valueOf(transactionDto.getOrderAmount() == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getOrderAmount())))
                .totalAmount(String.valueOf(transactionDto.getDebitAmt()) == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getDebitAmt()))
                .atrn(transactionDto.getAtrnNum() == null ? OtherInbConstants.EMPTY : transactionDto.getAtrnNum())
                .transactionStatus(finalResponseStatus.getStatus())
                .reason(finalResponseStatus.getResponseReason())
                .CIN(transactionDto.getCin() == null ? OtherInbConstants.EMPTY : transactionDto.getCin())
                .otherDetails(order.getOtherDetails() == null ? OtherInbConstants.EMPTY : order.getOtherDetails())
                .bankName(transactionDto.getChannelBank() == null ? OtherInbConstants.EMPTY : transactionDto.getChannelBank())
                .bankTxnNumber(responseDto.getTId() == null ? OtherInbConstants.EMPTY : responseDto.getTId())
                .bankCode(transactionDto.getPayMode() == null ? OtherInbConstants.EMPTY : transactionDto.getPayMode())
                .customerId(order.getCustomerId() == null ? OtherInbConstants.EMPTY : order.getCustomerId())
                .orderRetryCount(String.valueOf(order.getOrderRetryCount()) == null ? OtherInbConstants.EMPTY : String.valueOf(order.getOrderRetryCount()))
                .build();
    }

    public FinalResponseStatus getStatus(TransactionDto transactionDto, Order order, String channelStatus, String failureReason) {
        if (!transactionDto.getOrderAmount().equals(order.getOrderAmount())) {
            return FinalResponseStatus.builder().status(OtherInbConstants.FAILED).responseReason(OtherInbConstants.FAILED_FOR_AMOUNT_NOT_MATCHED).build();
        } else {
            return FinalResponseStatus.builder().status(channelStatus).responseReason(failureReason.replaceAll(OtherInbConstants.SPECIAL_CHAR_REGEX, OtherInbConstants.EMPTY)).build();
        }
    }
}


