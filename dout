import com.epay.otherinb.exceptions.OtherInbPaymentException;
import com.epay.otherinb.model.request.DhanalaxmiDvRequest;
import com.epay.otherinb.model.response.DhanalaxmiDvResponse;
import com.epay.otherinb.util.constants.ErrorConstants;
import com.sbi.epay.logging.utility.LoggerFactoryUtility;
import com.sbi.epay.logging.utility.LoggerUtility;
import lombok.RequiredArgsConstructor;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

@Component
@RequiredArgsConstructor
public class DhanalaxmiPaymentWebClientService {
    
    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private static final String DV_API_URL = "https://ngib.dhanbank.in:8443/rib-rest/payment/paymentDoubleVerification";

    public DhanalaxmiDvResponse processingDoubleVerRequest(String encryptedDvData) {
        logger.info("Initiating Dhanlaxmi Double Verification API S2S call.");

        DhanalaxmiDvRequest requestJson = DhanalaxmiDvRequest.builder()
                .merchantID("PGREFID")
                .encDhanaBankData(encryptedDvData)
                .build();

        try {
            WebClient webClient = WebClient.builder().build();
            
            DhanalaxmiDvResponse response = webClient.post()
                    .uri(DV_API_URL)
                    .contentType(MediaType.APPLICATION_JSON)
                    .bodyValue(requestJson)
                    .retrieve()
                    .onStatus(status -> status.is4xxClientError() || status.is5xxServerError(),
                            clientResponse -> clientResponse.bodyToMono(String.class)
                                    .flatMap(error -> {
                                        logger.error("DV API Error Response from Bank: {}", error);
                                        return Mono.error(new OtherInbPaymentException(
                                                ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "DV API Error: " + error));
                                    }))
                    .bodyToMono(DhanalaxmiDvResponse.class)
                    .block();

            logger.info("DV API Response received successfully. Status Code: {}", response != null ? response.getStatusCode() : "null");
            return response;

        } catch (Exception e) {
            logger.error("Exception during DV WebClient Call: {}", e.getMessage(), e);
            throw new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE,
                    ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE);
        }
    }
}


